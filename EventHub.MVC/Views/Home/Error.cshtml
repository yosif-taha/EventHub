@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="card">
    <h1>Something went wrong</h1>
    <p>We could not complete that request. Please try again later.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID: @Model.RequestId</p>
    }
</section>
