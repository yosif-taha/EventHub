@model OrganizerAttendeesViewModel
@{
    ViewData["Title"] = "Event attendees";
}

<section class="page-heading page-heading-with-action">
    <div>
        <h1>Attendees</h1>
        <p>@Model.EventTitle</p>
    </div>
    <a class="button secondary" asp-action="Events">Back to events</a>
</section>

@if (TempData["Success"] is string success)
{
    <div class="message success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="message error" role="alert">@error</div>
}

@if (Model.Attendees.Items.Count == 0)
{
    <section class="card empty-state">
        <h2>No registrations yet</h2>
        <p>Attendees will appear here once they register.</p>
    </section>
}
else
{
    <section class="card table-card">
        <div class="table-scroll">
            <table>
                <caption>Event registrations and attendee contact details</caption>
                <thead><tr><th scope="col">Attendee</th><th scope="col">Email</th><th scope="col">Registration date</th><th scope="col">Status</th></tr></thead>
                <tbody>
                @foreach (var attendee in Model.Attendees.Items)
                {
                    <tr>
                        <td>@attendee.AttendeeName</td>
                        <td><a href="mailto:@attendee.AttendeeEmail">@attendee.AttendeeEmail</a></td>
                        <td>@attendee.RegistrationDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="status @attendee.Status.ToLowerInvariant()">@attendee.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <nav class="pagination" aria-label="Attendee pages">
        @if (Model.Attendees.HasPreviousPage)
        {
            <a asp-action="Attendees" asp-route-id="@Model.EventId" asp-route-pageNumber="@(Model.Attendees.PageNumber - 1)">Previous</a>
        }
        <span>Page @Model.Attendees.PageNumber of @Model.Attendees.TotalPages</span>
        @if (Model.Attendees.HasNextPage)
        {
            <a asp-action="Attendees" asp-route-id="@Model.EventId" asp-route-pageNumber="@(Model.Attendees.PageNumber + 1)">Next</a>
        }
    </nav>
}

<div class="action-row page-actions">
    <a class="button secondary" asp-action="Statistics" asp-route-id="@Model.EventId">View statistics</a>
    <a class="button" asp-action="Announcement" asp-route-id="@Model.EventId">Send announcement</a>
</div>
