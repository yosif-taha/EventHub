@model EventEditorViewModel
@{
    ViewData["Title"] = "Edit event";
}

<section class="page-heading">
    <h1>Edit event</h1>
    <p>Only scheduled events can be changed. Attendees are notified when event details change.</p>
</section>

<section class="card form-card">
    <form asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]" method="post">
        <partial name="_EventFields" model="Model" />
        <div class="action-row">
            <button type="submit" class="button">Save changes</button>
            <a class="button secondary" asp-action="Events">Cancel</a>
        </div>
    </form>
</section>
