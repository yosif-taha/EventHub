@model EventEditorViewModel
@{
    ViewData["Title"] = "Edit event";
}

<section class="page-heading"><h1>Edit event</h1><p>Only scheduled events can be updated. The existing API does not allow price changes.</p></section>
<section class="card form-card">
    <form asp-action="Edit" asp-route-id="@Context.Request.RouteValues["id"]" method="post">
        <partial name="~/Views/Organizer/_EventFields.cshtml" model="Model" />
        <div class="action-row"><button type="submit" class="button">Save changes</button><a class="button secondary" asp-action="Events">Cancel</a></div>
    </form>
</section>
