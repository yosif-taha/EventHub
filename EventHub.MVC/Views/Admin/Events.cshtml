@model AdminEventListViewModel
@{
    ViewData["Title"] = "Manage events";
}

<section class="page-heading page-heading-with-action">
    <div>
        <h1>Manage events</h1>
        <p>View and administer events across the system.</p>
    </div>
    <a class="button" asp-action="Create">Create event</a>
</section>

@if (TempData["Success"] is string success)
{
    <div class="message success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="message error" role="alert">@error</div>
}

<form method="get" class="filter-card">
    <div class="filter-grid">
        <div class="form-field"><label asp-for="Filter.SearchValue">Search</label><input asp-for="Filter.SearchValue" placeholder="Title or location" /></div>
        <div class="form-field">
            <label asp-for="Filter.CategoryId">Category</label>
            <select asp-for="Filter.CategoryId"><option value="">All categories</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select>
        </div>
        <div class="form-field">
            <label asp-for="Filter.SortColumn">Sort by</label>
            <select asp-for="Filter.SortColumn"><option value="">Default</option><option value="Title">Title</option><option value="Location">Location</option></select>
        </div>
        <div class="form-field">
            <label asp-for="Filter.SortDirection">Direction</label>
            <select asp-for="Filter.SortDirection"><option value="asc">Ascending</option><option value="desc">Descending</option></select>
        </div>
    </div>
    <button type="submit" class="button">Apply filters</button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="message error" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Events.Items.Count == 0)
{
    <section class="card empty-state"><h2>No events found</h2><p>Try adjusting the filters.</p></section>
}
else
{
    <section class="event-grid" aria-label="All events">
        @foreach (var evt in Model.Events.Items)
        {
            <article class="event-card">
                <div class="event-card-header"><span class="status @evt.Status.ToLowerInvariant()">@evt.Status</span><span>@evt.CategoryName</span></div>
                <h2>@evt.Title</h2>
                <p>@evt.Description</p>
                <dl class="event-meta">
                    <div><dt>Date</dt><dd>@evt.EventDate.ToLocalTime().ToString("ddd, dd MMM yyyy HH:mm")</dd></div>
                    <div><dt>Location</dt><dd>@evt.Location (@evt.Mode)</dd></div>
                    <div><dt>Capacity</dt><dd>@evt.CurrentAttendeesCount of @evt.MaxAttendees attendees</dd></div>
                    <div><dt>Price</dt><dd>@(evt.PaymentRequired ? $"{evt.Price:N2} EGP" : "Free")</dd></div>
                </dl>
                <div class="action-row">
                    <a class="button secondary" asp-controller="Events" asp-action="Details" asp-route-id="@evt.Id">View</a>
                    <a class="button secondary" asp-action="Attendees" asp-route-id="@evt.Id">Attendees</a>
                    <a class="button secondary" asp-action="Announcement" asp-route-id="@evt.Id">Announcement</a>
                    @if (evt.Status.Equals("Scheduled", StringComparison.OrdinalIgnoreCase))
                    {
                        <a class="button secondary" asp-action="Edit" asp-route-id="@evt.Id">Edit</a>
                        <form asp-action="Cancel" asp-route-id="@evt.Id" method="post" onsubmit="return confirm('Cancel this event? Confirmed attendees will be notified.');"><button type="submit" class="button danger">Cancel event</button></form>
                    }
                    <form asp-action="Delete" asp-route-id="@evt.Id" method="post" onsubmit="return confirm('Delete this event? This existing backend action does not use the cancellation notification workflow.');"><button type="submit" class="button danger">Delete event</button></form>
                </div>
            </article>
        }
    </section>
    <nav class="pagination" aria-label="Event pages">
        @if (Model.Events.HasPreviousPage) { <a asp-action="Events" asp-route-searchValue="@Model.Filter.SearchValue" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-sortColumn="@Model.Filter.SortColumn" asp-route-sortDirection="@Model.Filter.SortDirection" asp-route-pageNumber="@(Model.Events.PageNumber - 1)">Previous</a> }
        <span>Page @Model.Events.PageNumber of @Model.Events.TotalPages</span>
        @if (Model.Events.HasNextPage) { <a asp-action="Events" asp-route-searchValue="@Model.Filter.SearchValue" asp-route-categoryId="@Model.Filter.CategoryId" asp-route-sortColumn="@Model.Filter.SortColumn" asp-route-sortDirection="@Model.Filter.SortDirection" asp-route-pageNumber="@(Model.Events.PageNumber + 1)">Next</a> }
    </nav>
}
