@model MyRegistrationsViewModel
@{
    ViewData["Title"] = "My registrations";
}

<section class="page-heading">
    <h1>My registrations</h1>
    <p>Review your event registrations and their current payment status.</p>
</section>

@if (TempData["Success"] is string success)
{
    <div class="message success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="message error" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="message error" role="alert">@Model.ErrorMessage</div>
}
else if (Model.Registrations.Items.Count == 0)
{
    <section class="card empty-state">
        <h2>No registrations yet</h2>
        <p>Browse available events to reserve your place.</p>
        <a class="button" asp-controller="Events" asp-action="Index">Explore events</a>
    </section>
}
else
{
    <section class="registration-list">
        @foreach (var registration in Model.Registrations.Items)
        {
            <article class="card registration-card">
                <div>
                    <h2><a asp-controller="Events" asp-action="Details" asp-route-id="@registration.EventId">@registration.EventTitle</a></h2>
                    <p>@registration.EventStartDate.ToLocalTime().ToString("ddd, dd MMM yyyy HH:mm") · @registration.EventLocation · @registration.EventMode</p>
                    <p>Registration: <span class="status @registration.Status.ToLowerInvariant()">@registration.Status</span></p>
                    @if (registration.PaymentRequired)
                    {
                        <p>Payment: <span class="status @(registration.PaymentStatus?.ToString().ToLowerInvariant() ?? "pending")">@(registration.PaymentStatus?.ToString() ?? "Pending")</span></p>
                    }
                </div>
                <div class="registration-actions">
                    @if (!registration.Status.Equals("Canceled", StringComparison.OrdinalIgnoreCase))
                    {
                        <form asp-action="Cancel" asp-route-registrationId="@registration.Id" method="post" onsubmit="return confirm('Cancel this registration?');">
                            <button type="submit" class="button danger">Cancel registration</button>
                        </form>
                    }
                </div>
            </article>
        }
    </section>

    <nav class="pagination" aria-label="Registration pages">
        @if (Model.Registrations.HasPreviousPage)
        {
            <a asp-action="My" asp-route-pageNumber="@(Model.Registrations.PageNumber - 1)">Previous</a>
        }
        <span>Page @Model.Registrations.PageNumber of @Model.Registrations.TotalPages</span>
        @if (Model.Registrations.HasNextPage)
        {
            <a asp-action="My" asp-route-pageNumber="@(Model.Registrations.PageNumber + 1)">Next</a>
        }
    </nav>
}
