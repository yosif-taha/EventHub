@model RegistrationPaymentStatusDto
@{
    ViewData["Title"] = "Payment status";
    var paymentStatus = Model.PaymentStatus?.ToString() ?? "Pending";
}

<section class="card payment-status">
    <h1>Payment status</h1>
    <p><strong>@Model.EventTitle</strong></p>
    <dl class="event-meta details-meta">
        <div><dt>Registration</dt><dd><span class="status @Model.RegistrationStatus.ToString().ToLowerInvariant()">@Model.RegistrationStatus</span></dd></div>
        @if (Model.PaymentRequired)
        {
            <div><dt>Payment</dt><dd><span class="status @paymentStatus.ToLowerInvariant()">@paymentStatus</span></dd></div>
            <div><dt>Amount</dt><dd>@Model.PaymentAmount?.ToString("N2") @Model.PaymentCurrency</dd></div>
        }
    </dl>

    @if (Model.PaymentStatus?.ToString() == "Success" && Model.RegistrationStatus.ToString() == "Confirmed")
    {
        <p class="message success">Your payment and registration are confirmed.</p>
    }
    else if (Model.PaymentStatus?.ToString() is "Failed" or "Canceled")
    {
        <p class="message error">Your payment was not completed. The status shown is the backend-confirmed result.</p>
    }
    else
    {
        <p class="message">Your payment is still pending confirmation. This page does not treat the browser return as payment confirmation.</p>
    }

    <a class="button" asp-action="PaymentReturn" asp-route-registrationId="@Model.RegistrationId">Refresh status</a>
    <a class="button secondary" asp-action="My">View my registrations</a>
</section>
